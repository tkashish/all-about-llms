      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Each scheduler has only 1\u20132 warps.\nWhen one stalls, scheduler idles.\nBig gaps of 32+ idle cores.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Each scheduler has only 1\u20132 warps.\nWhen one stalls, scheduler idles.\nBig gaps of 32+ idle cores."
