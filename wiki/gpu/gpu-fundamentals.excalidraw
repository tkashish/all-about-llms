      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Each scheduler has ~12 resident warps.\nWhen one stalls, another runs.\n128 cores busy almost every cycle.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Each scheduler has ~12 resident warps.\nWhen one stalls, another runs.\n128 cores busy almost every cycle."
    },
