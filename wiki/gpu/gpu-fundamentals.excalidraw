      "locked": false,
      "text": "Each cycle, each scheduler picks ONE ready warp and issues ONE instruction.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Each cycle, each scheduler picks ONE ready warp and issues ONE instruction."
    },
    {
      "id": "t1244",
      "type": "text",
      "x": 95,
      "y": 1218,
      "width": 1400,
      "height": 21,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1245,
      "version": 1,
      "versionNonce": 1246,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "That instruction is EITHER a memory op (load/store to HBM/SRAM) OR a compute op (CUDA or Tensor core).",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "That instruction is EITHER a memory op (load/store to HBM/SRAM) OR a compute op (CUDA or Tensor core)."
    },
