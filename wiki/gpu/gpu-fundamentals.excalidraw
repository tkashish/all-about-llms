      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cycles 7\u201310+: scheduler 0's 2 warps both stalled on HBM. 32 CUDA cores idle, ~700 cycles.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Cycles 7\u201310+: scheduler 0's 2 warps both stalled on HBM. 32 CUDA cores idle, ~700 cycles."
    },
    {
      "id": "t4208",
      "type": "text",
      "x": 80,
      "y": 4620,
      "width": 1400,
      "height": 21,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 4209,
      "version": 1,
      "versionNonce": 4210,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "This is LOW-OCCUPANCY memory-bound behavior. Fix: more warps per scheduler.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "This is LOW-OCCUPANCY memory-bound behavior. Fix: more warps per scheduler."
    },
