      "text": "EXECUTION MODEL \u2014 how your kernel runs on the hardware",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
