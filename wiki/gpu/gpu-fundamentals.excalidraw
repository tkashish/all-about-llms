      "versionNonce": 1156,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Scope: logical, per-kernel. You pick grid and block size; GPU handles the rest.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Scope: logical, per-kernel. You pick grid and block size; GPU handles the rest."
    },
