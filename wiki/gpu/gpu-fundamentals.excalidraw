      "version": 1,
      "versionNonce": 3508,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)"
    },
    {
