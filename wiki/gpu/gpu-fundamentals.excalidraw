      "roundness": null,
      "seed": 1197,
      "version": 1,
      "versionNonce": 1198,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 4 warps \u00d7 32 cores = 128 CUDA cores busy per cycle (all of them)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022 4 warps \u00d7 32 cores = 128 CUDA cores busy per cycle (all of them)"
    },
    {
      "id": "t1199",
      "type": "text",
