      "versionNonce": 2806,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "In Triton: offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)  \u2192  coalesced by construction.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
