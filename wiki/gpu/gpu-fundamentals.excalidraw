    {
      "id": "t3398",
      "type": "text",
      "x": 80,
      "y": 3041,
      "width": 1400,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
