      "version": 1,
      "versionNonce": 1201,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Stalled warps (waiting on memory) \u2192 scheduler swaps in another resident warp.\nThis is how the GPU hides memory latency \u2014 with occupancy.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Stalled warps (waiting on memory) \u2192 scheduler swaps in another resident warp.\nThis is how the GPU hides memory latency \u2014 with occupancy."
    },
