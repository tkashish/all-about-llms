      "text": "WARP SCHEDULING \u2014 occupancy and latency hiding",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "WARP SCHEDULING \u2014 occupancy and latency hiding"
    },
    {
      "id": "t2813",
      "type": "text",
      "x": 80,
      "y": 2530,
      "width": 1400,
      "height": 22,
      "angle": 0,
      "strokeColor": "#d9480f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
