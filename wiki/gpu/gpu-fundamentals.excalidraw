      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "def vector_add(x_ptr, y_ptr, out_ptr, n,",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "def vector_add(x_ptr, y_ptr, out_ptr, n,"
    },
    {
      "id": "t3500",
