      "roundness": null,
      "seed": 3399,
      "version": 1,
      "versionNonce": 3400,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Scheduler 0 issued W0's HBM load at cycle 1. W0 is stalled ~700 cycles. Sched 0 keeps its 32 cores busy by running W4 and W8 instead.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Scheduler 0 issued W0's HBM load at cycle 1. W0 is stalled ~700 cycles. Sched 0 keeps its 32 cores busy by running W4 and W8 instead."
    },
    {
      "id": "t3401",
      "type": "text",
      "x": 80,
      "y": 3061,
      "width": 1400,
      "height": 20,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3402,
      "version": 1,
      "versionNonce": 3403,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cycle 7: all of sched 0's pool happens to be stalled (unusual \u2014 needs more warps) \u2192 32 cores IDLE that cycle. This is the occupancy cost.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Cycle 7: all of sched 0's pool happens to be stalled (unusual \u2014 needs more warps) \u2192 32 cores IDLE that cycle. This is the occupancy cost."
    },
