      "versionNonce": 2065,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Memory instructions: don't use cores \u2014 they issue a request and wait. Scheduler picks different warp next cycle.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Memory instructions: don't use cores \u2014 they issue a request and wait. Scheduler picks different warp next cycle."
    },
