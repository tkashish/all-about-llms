      "updated": 1,
      "link": null,
      "locked": false,
      "text": "HBM delivers memory in 128-byte cache lines. The # of cache lines your warp touches = # of memory transactions = your effective bandwidth.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "HBM delivers memory in 128-byte cache lines. The # of cache lines your warp touches = # of memory transactions = your effective bandwidth."
    },
