      "roundness": null,
      "seed": 2814,
      "version": 1,
      "versionNonce": 2815,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Inside one SM: 4 schedulers, up to 48 resident warps, ~600\u2013800 cycle HBM latency. Occupancy = how well you hide stalls.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Inside one SM: 4 schedulers, up to 48 resident warps, ~600\u2013800 cycle HBM latency. Occupancy = how well you hide stalls."
    },
