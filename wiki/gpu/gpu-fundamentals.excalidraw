      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "e.g. grid_size=(3907,), BLOCK_SIZE=256  \u2192  3907 blocks, 256 threads each, 1M total threads",
