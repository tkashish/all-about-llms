      "versionNonce": 2053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Compute op \u2192 32 threads use\nthe scheduler's 32 cores this cycle.\nOne thread per core.",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "Compute op \u2192 32 threads use\nthe scheduler's 32 cores this cycle.\nOne thread per core."
    },
