      "link": null,
      "locked": false,
      "text": "1. You launch:  kernel[grid_size](args, BLOCK_SIZE=...)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "1. You launch:  kernel[grid_size](args, BLOCK_SIZE=...)"
    },
    {
      "id": "t1163",
      "type": "text",
      "x": 120,
      "y": 725,
      "width": 1300,
