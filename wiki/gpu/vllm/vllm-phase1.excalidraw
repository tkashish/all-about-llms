      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Static: 5 seqs in 8 steps.  Continuous: 9 seqs in 10 steps.  ~80% more throughput, same GPU.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Static: 5 seqs in 8 steps.  Continuous: 9 seqs in 10 steps.  ~80% more throughput, same GPU."
