      "versionNonce": 110,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Blue = Sequence A's blocks  |  Green = Sequence B's blocks  |  Gray = free.\nNote the blocks are NOT contiguous \u2014 A uses 3 and 1, B uses 5 and 2. Scattering is fine; the block table glues them back together.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Blue = Sequence A's blocks  |  Green = Sequence B's blocks  |  Gray = free.\nNote the blocks are NOT contiguous \u2014 A uses 3 and 1, B uses 5 and 2. Scattering is fine; the block table glues them back together."
    },
